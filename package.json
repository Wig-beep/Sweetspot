{
  "name": "loopinsight1",
  "version": "2.1.0",
  "sweetspotVersion": "0.1.0",
  "description": "A modular framework for in-browser diabetes simulation",
  "type": "module",
  "scripts": {
    "serve": "npx cross-env NODE_OPTIONS=--import=./register.js --moduleResolution=nodenext --target=es2017 webpack serve --config webpack.dev.ts --stats-modules-space 999",
    "typecheck": "vue-tsc --noEmit",
    "test:components": "vitest run",
    "build": "npx cross-env NODE_ENV=production NODE_OPTIONS=--import=./register.js --moduleResolution=nodenext --target=es2017 webpack build --config webpack.prod.ts --stats-modules-space 999",
    "test": "npx c8 mocha",
    "test:e2e": "npm run build && playwright test"
  },
  "author": "Heiko Peuscher",
  "license": "MIT",
  "dependencies": {
    "@svgdotjs/svg.js": "^3.2.0",
    "chart.js": "^4.4.7",
    "chartjs-adapter-date-fns": "^3.0.0",
    "d3": "^7.8.5",
    "date-fns": "^4.4.0",
    "floating-vue": "^5.2.2",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "moment-timezone": "^0.5.48",
    "use-resize-observer": "^9.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@intlify/vue-i18n-loader": "^4.2.0",
    "@playwright/test": "^1.63.0",
    "@types/chai": "^5.0.1",
    "@types/d3": "^7.4.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.7",
    "@types/picomatch": "^4.0.3",
    "@types/webpack": "^5.28.5",
    "@types/webpack-dev-server": "^4.7.1",
    "@types/webpack-env": "^1.18.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "chai": "^5.1.2",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "file-loader": "^6.2.0",
    "happy-dom": "^20.14.5",
    "html-webpack-plugin": "^5.6.3",
    "mocha": "^12.0.3",
    "process": "^0.11.10",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3",
    "vue": "^3.5.13",
    "vue-hot-reload-api": "^2.3.4",
