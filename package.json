    "vue-style-loader": "^4.1.3",
    "vue-tsc": "^3.3.12",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
